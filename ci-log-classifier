import os
import sys
import csv
import psycopg2

PASSWORD = os.environ.get("PGPASSWORD")
if not PASSWORD:
    sys.exit("Set PGPASSWORD first.")

# Rules are checked in this order. The first match wins.
RULES = [
    ("missing_dependency", ["modulenotfounderror", "no module named",
        "could not find a version that satisfies", "no matching distribution",
        "cannot find module", "unable to locate package", "importerror: cannot import",
        "package not found", "dependency resolution"]),
    ("network_error", ["connection refused", "connection reset", "could not resolve host",
        "temporary failure in name resolution", "max retries exceeded", "connectionerror",
        "network is unreachable", "502 bad gateway", "503 service", "read timed out",
        "ssl: certificate", "failed to connect"]),
    ("timeout", ["timed out", "timeouterror", "exceeded the maximum execution time",
        "operation was canceled", "deadline exceeded"]),
    ("lint_error", ["flake8", "ruff", "pylint", "eslint", "would reformat",
        "black --check", "isort", "mypy", "codespell", "trailing whitespace",
        "pre-commit"]),
    ("test_failure", ["assertionerror", "short test summary info", "error collecting",
        "== failures ==", "tests failed", "failed tests", "test failed"]),
]


def label(text):
    tail = "\n".join(text.splitlines()[-60:]).lower()
    for name, words in RULES:
        if any(w in tail for w in words):
            return name
    return "other"


conn = psycopg2.connect(host="localhost", port=5432, user="postgres",
                        password=PASSWORD, dbname="ci_logs")
cur = conn.cursor()
cur.execute("ALTER TABLE logs ADD COLUMN IF NOT EXISTS label TEXT")
conn.commit()

cur.execute("SELECT id, log_text FROM logs")
rows = cur.fetchall()
print(f"Labeling {len(rows)} logs...")
for log_id, text in rows:
    cur.execute("UPDATE logs SET label = %s WHERE id = %s", (label(text), log_id))
conn.commit()

cur.execute("SELECT label, COUNT(*) FROM logs GROUP BY label ORDER BY COUNT(*) DESC")
print("\nLabel counts:")
for name, n in cur.fetchall():
    print(f"  {name}: {n}")

# Save 100 random logs for checking by hand
cur.execute("SELECT id, repo, label, log_text FROM logs ORDER BY random() LIMIT 100")
with open("label_check.csv", "w", newline="", encoding="utf-8") as f:
    w = csv.writer(f)
    w.writerow(["id", "repo", "auto_label", "last_15_lines", "correct_label"])
    for log_id, repo, lab, text in cur.fetchall():
        w.writerow([log_id, repo, lab, "\n".join(text.splitlines()[-15:]), ""])
print("\nSaved label_check.csv (100 logs to check by hand)")
conn.close()